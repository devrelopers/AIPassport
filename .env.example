# ---------------------------------------------------------------------------
# AIPassport Broker Configuration
# ---------------------------------------------------------------------------

# AI Provider API Keys
# These are stored server-side only and never exposed to third-party apps.
# At least one provider key is required for the proxy to work.
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# GOOGLE_API_KEY=your-google-ai-key-here

# Server
PORT=3001

# Token Settings
# How long delegated JWT tokens remain valid, in seconds.
TOKEN_TTL_SECONDS=3600

# JWT Signing
# HMAC secret for signing delegated tokens. If not set, a random key is
# generated on startup (tokens will not survive restarts).
# For production, set this to a long random string.
# JWT_SECRET=change-me-to-a-long-random-string
